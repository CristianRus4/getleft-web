/.well-known/apple-app-site-association
  Content-Type: application/json

/.well-known/todoist-oauth-client.json
  Content-Type: application/json
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

/.well-known/todoist-oauth-client-v2.json
  Content-Type: application/json
  X-Content-Type-Options: nosniff
  Cache-Control: public, max-age=300

/friends
  Content-Type: text/html; charset=utf-8

/llms.txt
  Content-Type: text/plain; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

# HSTS: browsers always use HTTPS for getleft.app (6 months; subdomains not included). Set here rather than
# in the Cloudflare dashboard, so it lives with the site. Raise max-age to 1 year once it has run clean.
/*
  Strict-Transport-Security: max-age=15552000
